<programa> ::= <expressao>
<expressao> ::= <termo> ( ('+' | '-') <termo> )*
<termo> ::= <fator> ( ('*' | '/') <fator> )*
<fator> ::= <numero> | <variavel> | '(' <expressao> ')'
<numero> ::= [0-9]+(\.[0-9]+)?
<variavel> ::= [a-zA-Z_][a-zA-Z_0-9]*

import re

# Função para identificar se o token é um número
def is_number(token):
    return re.match(r"^[0-9]+(\.[0-9]+)?$", token)

# Função para identificar se o token é uma variável
def is_variable(token):
    return re.match(r"^[a-zA-Z_][a-zA-Z_0-9]*$", token)

# Função para avaliar uma expressão
def evaluate_expression(expression, variables, history):
    try:
        # Expressões aceitas
        tokens = re.findall(r"[0-9]+(\.[0-9]+)?|[a-zA-Z_][a-zA-Z_0-9]*|[+\-*/()]|=", expression)

        def eval_tokens(tokens):
            stack = []
            postfix = []
            ops = {'+': 1, '-': 1, '*': 2, '/': 2}

            def precedence(op):
                return ops[op] if op in ops else 0

            def apply_operator(operators, values):
                right = values.pop()
                left = values.pop()
                op = operators.pop()
                if op == '+':
                    values.append(left + right)
                elif op == '-':
                    values.append(left - right)
                elif op == '*':
                    values.append(left * right)
                elif op == '/':
                    values.append(left / right)

            # Convert infix to postfix
            for token in tokens:
                if is_number(token):
                    postfix.append(float(token))
                elif is_variable(token):
                    if token in history:
                        # Se a variável estiver no histórico de resultados
                        postfix.append(history[token])
                    elif token in variables:
                        postfix.append(variables[token])
                    else:
                        raise ValueError(f"Erro: variável '{token}' não declarada.")
                elif token in ops:
                    while (stack and precedence(token) <= precedence(stack[-1])):
                        postfix.append(stack.pop())
                    stack.append(token)
                elif token == '(':
                    stack.append(token)
                elif token == ')':
                    while stack and stack[-1] != '(':
                        postfix.append(stack.pop())
                    stack.pop()  # Remover o '('
            
            while stack:
                postfix.append(stack.pop())

            # Avaliar a expressão postfix
            values = []
            for token in postfix:
                if isinstance(token, float):
                    values.append(token)
                else:
                    apply_operator(stack, values)

            return values[0]

        # Avaliando os tokens da expressão
        result = eval_tokens(tokens)
        
        # Armazenando o resultado no histórico
        history[f"resultado_{len(history) + 1}"] = result

        return result

    except Exception as e:
        return str(e)

# Função para exibir o histórico de resultados
def show_history(history):
    print("\nHistórico de Resultados:")
    for key, value in history.items():
        print(f"{key}: {value}")

# Variáveis pré-definidas
variables = {"x": 10, "y": 20}

# Histórico para armazenar os resultados anteriores
history = {}

# Testando a calculadora com armazenamento de resultados
while True:
    expression = input("\nDigite uma expressão (ou 'sair' para terminar, 'historico' para ver resultados passados): ")
    if expression.lower() == "sair":
        break
    elif expression.lower() == "historico":
        show_history(history)
    else:
        result = evaluate_expression(expression, variables, history)
        print(f"Resultado: {result}")

