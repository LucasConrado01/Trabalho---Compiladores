#!/usr/bin/python3
import sys
from antlr4 import *  # Importa a biblioteca ANTLR para manipulação de lexer, parser, e árvore de sintaxe
from dist.CalculantlrLexer import CalculantlrLexer  # Importa o lexer gerado a partir da gramática ANTLR
from dist.CalculantlrParser import CalculantlrParser  # Importa o parser gerado a partir da gramática ANTLR
from dist.CalculantlrVisitor import CalculantlrVisitor  # Importa a classe visitor gerada para visitar a árvore de sintaxe


# Classe personalizada que herda de CalculantlrVisitor, permitindo visitar e avaliar a árvore de sintaxe
class EvalVisitor(CalculantlrVisitor):

    # Método que trata expressões literais, como números. Converte o texto em um número.
    def visitLiteralExpr(self, ctx:CalculantlrParser.LiteralExprContext):
        return int(ctx.getText())  # Converte o texto da expressão literal em um inteiro

    # Método que trata expressões com parênteses, retornando a avaliação da expressão dentro dos parênteses.
    def visitGroupExpr(self, ctx:CalculantlrParser.GroupExprContext):
        return self.visit(ctx.expr())  # Visita e avalia a expressão dentro dos parênteses

    # Método que trata operações binárias (+, -, *, /) entre duas expressões.
    def visitOperationExpr(self, ctx:CalculantlrParser.OperationExprContext):
        left = self.visit(ctx.left)  # Avalia o lado esquerdo da expressão
        right = self.visit(ctx.right)  # Avalia o lado direito da expressão

        operator = ctx.op.text  # Obtém o operador da expressão (ex: +, -, *, /)
        # Realiza a operação com base no operador
        if operator == '+':
            return left + right
        elif operator == '-':
            return left - right
        elif operator == '*':
            return left * right
        elif operator == '/':
            if right == 0:  # Verifica divisão por zero
                print('Erro: divisão por zero!')
                return 0
            return left / right


# Função que processa a entrada de uma expressão e a avalia
def evaluate(expression) -> float:
    input_stream = InputStream(expression)  # Cria um fluxo de entrada a partir da expressão

    # Lexical analysis (tokenização)
    lexer = CalculantlrLexer(input_stream)  # Cria o lexer a partir do fluxo de entrada
    token_stream = CommonTokenStream(lexer)  # Cria um fluxo de tokens a partir do lexer

    # Syntax analysis (parsing)
    parser = CalculantlrParser(token_stream)  # Cria o parser a partir do fluxo de tokens
    syntax_tree = parser.expr()  # Analisa a expressão e gera a árvore de sintaxe

    # Visitor traversal for evaluation
    eval_visitor = EvalVisitor()  # Cria um visitante para avaliar a árvore de sintaxe
    return eval_visitor.visit(syntax_tree)  # Avalia e retorna o resultado da árvore


# Loop principal para permitir a entrada de várias expressões
if __name__ == '__main__':
    while True:
        print(">>> ", end='')  # Prompt de entrada
        expr = input()  # Lê a expressão do usuário
        print(evaluate(expr))  # Avalia e imprime o resultado da expressão



